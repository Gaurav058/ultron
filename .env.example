# ULTRON OS — Environment Configuration
# NEVER commit your actual API keys to version control.

# Google Gemini API Key (Server-side only)
# Get a key from Google AI Studio: https://aistudio.google.com/
GEMINI_API_KEY=

# Google Maps Platform API Key (Client-side 3D Earth)
# Get a key from Google Cloud Console with Maps JavaScript API & Geocoding enabled:
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=

# Model Routing Configuration
# Fast conversational model (lowest latency for streaming text and turns)
GEMINI_TEXT_MODEL=gemini-2.5-flash

# Real-time voice model for Gemini Live bidirectional audio sessions
GEMINI_LIVE_MODEL=gemini-2.5-flash

# High-capability reasoning model for complex DAG compilation & code synthesis
GEMINI_REASONING_MODEL=gemini-2.5-pro

# Server Configuration
PORT=3000
NODE_ENV=production
NEXT_TELEMETRY_DISABLED=1
